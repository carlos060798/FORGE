{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-sdd.dev/contrato/estado-ciclo/1.1",
  "title": "Estado del ciclo verificado (por tarea)",
  "description": "EstadoCiclo de core/ciclo/estado.js. Version del artefacto: `schemaVersion` (cadena \"1.0\"). Distinto del estado del pipeline (.sdd/estado.json: ver estado-pipeline). Las reglas que JSON Schema no expresa (umbral_degradacion_usd <= tope_usd, detectadas <= probadas) las comprueba validarEstado.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "threadId", "taskId", "cwd", "tarea", "plan", "contexto", "pruebas", "implementacion", "ejecuciones", "iteracion", "maxIteraciones", "presupuesto", "revision", "resultado"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "runId": { "type": "string", "minLength": 1 },
    "threadId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "cwd": { "type": "string", "minLength": 1 },
    "tarea": { "type": "object", "additionalProperties": false, "required": ["id", "descripcion", "agente", "archivos", "cas"],
      "properties": {
        "id": { "type": "string" },
        "descripcion": { "type": "string", "x-interno": true },
        "agente": { "type": "string" },
        "archivos": { "type": "array", "items": { "type": "string" } },
        "cas": { "type": "array", "items": { "type": "string" } },
        "criterioCmd": { "type": "string" },
        "parte_de_codigo_existente": { "type": "boolean" }
      } },
    "plan": { "type": ["object", "null"], "x-interno": true },
    "contexto": { "type": "object", "x-interno": true },
    "pruebas": { "type": "object", "additionalProperties": false, "required": ["archivos", "comando"],
      "properties": {
        "archivos": { "type": "array", "items": { "type": "object", "required": ["ruta", "sha256"], "properties": { "ruta": { "type": "string" }, "sha256": { "type": "string" } } } },
        "comando": { "type": "string" }
      } },
    "implementacion": { "type": "object", "additionalProperties": false, "required": ["archivos"],
      "properties": {
        "archivos": { "type": "array", "items": { "type": "object", "required": ["ruta", "sha256"], "properties": { "ruta": { "type": "string" }, "sha256": { "type": "string" } } } }
      } },
    "rojo": { "type": ["object", "null"], "additionalProperties": false,
      "properties": {
        "estado": { "type": "string", "enum": ["fallan", "pasan", "exenta", "sin_comprobar"] },
        "reintentado": { "type": "boolean" }
      } },
    "mutacion": { "type": ["object", "null"], "description": "Medicion del ciclo (core/ciclo/mutacion.js), distinta de la de `verificar`. Solo se comprometen los campos listados; el resto es interno.",
      "required": ["probadas", "detectadas", "puntuacion", "parcial", "sobrevivientes", "refuerzos"],
      "properties": {
        "probadas": { "type": "integer", "minimum": 0 },
        "detectadas": { "type": "integer", "minimum": 0 },
        "puntuacion": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "parcial": { "type": "boolean" },
        "sobrevivientes": { "type": "array", "items": { "type": "object" } },
        "refuerzos": { "type": "integer", "minimum": 0 }
      } },
    "ejecuciones": { "type": "array", "items": { "type": "object", "required": ["iteracion", "categoria", "exitCode", "timedOut", "oomKilled", "durationMs"],
      "properties": {
        "iteracion": { "type": "integer", "minimum": 0 },
        "categoria": { "type": "string", "enum": ["pass", "fail", "timeout", "infra_error"] },
        "exitCode": { "type": ["integer", "null"] },
        "timedOut": { "type": "boolean" },
        "oomKilled": { "type": "boolean" },
        "durationMs": { "type": "number", "minimum": 0 },
        "sospecha": { "type": "array", "items": { "type": "string" }, "x-interno": true },
        "huellaSalida": { "type": "string", "x-interno": true },
        "stdoutCola": { "type": "string", "x-interno": true },
        "stderrCola": { "type": "string", "x-interno": true }
      } } },
    "iteracion": { "type": "integer", "minimum": 0 },
    "maxIteraciones": { "type": "integer", "minimum": 1 },
    "presupuesto": { "type": "object", "additionalProperties": false, "required": ["tope_usd", "umbral_degradacion_usd", "gastado_usd", "estado", "llamadas", "tokens_in", "tokens_out"],
      "properties": {
        "tope_usd": { "type": "number", "minimum": 0 },
        "umbral_degradacion_usd": { "type": "number", "minimum": 0 },
        "gastado_usd": { "type": "number", "minimum": 0 },
        "estado": { "type": "string", "enum": ["ok", "degradado", "agotado"] },
        "llamadas": { "type": "integer", "minimum": 0 },
        "tokens_in": { "type": "number", "minimum": 0 },
        "tokens_out": { "type": "number", "minimum": 0 }
      } },
    "revision": { "type": ["object", "null"], "required": ["motivo", "reanudarEn"],
      "properties": {
        "motivo": { "type": "string", "enum": ["iteraciones", "presupuesto", "infraestructura", "dependencias", "salida_invalida", "exito_sospechoso", "sin_progreso", "pruebas_no_fallan", "pruebas_debiles", "perfil"] },
        "reanudarEn": { "type": "string" },
        "detalle": { "type": "string", "x-interno": true },
        "decision": { "type": "string" },
        "ts": { "type": "string" }
      } },
    "resultado": { "type": "string", "enum": ["en_curso", "exito", "revision_pendiente", "aceptada_por_humano", "abortada"] },
    "implementador": { "type": "string", "enum": ["bloque", "turnos"], "x-interno": true },
    "turnos": { "type": "integer", "minimum": 0, "x-interno": true },
    "perfiles": { "type": "object", "x-interno": true, "description": "Perfil efectivo de cada rol del ciclo (planner, qa, coder) la primera vez que corrió (core/ciclo/perfiles.js). Opcional: los hilos anteriores no lo llevan.",
      "additionalProperties": { "type": "object", "additionalProperties": false, "required": ["rol", "herramientas", "rutasEscribir", "pasosMax", "pruebasMax", "contextoMaxBytes"],
        "properties": {
          "rol": { "type": "string", "enum": ["planner", "qa", "coder"] },
          "herramientas": { "type": "array", "items": { "type": "string" } },
          "rutasEscribir": { "type": "object", "additionalProperties": false, "required": ["clase", "prefijos"],
            "properties": { "clase": { "type": "string", "enum": ["ninguna", "pruebas", "no_pruebas"] }, "prefijos": { "type": ["array", "null"], "items": { "type": "string" } } } },
          "pasosMax": { "type": "integer", "minimum": 0 },
          "pruebasMax": { "type": "integer", "minimum": 0 },
          "contextoMaxBytes": { "type": "integer", "minimum": 0 }
        } } }
  }
}
