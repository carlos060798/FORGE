    "task_completed": { "contrato": true, "archivo": "principal" },
    "task_failed": { "contrato": true, "archivo": "principal" },
    "task_skipped": { "contrato": true, "archivo": "principal" },
    "task_paused": { "contrato": true, "archivo": "principal" },
