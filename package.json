{
  "name": "fragua",
  "version": "5.0.0-beta.1",
  "description": "Desarrollo guiado por especificaciones en español, de la idea al código verificado: especifica, construye, prueba y verifica con un ciclo aislado. 14 agentes especializados, 39 comandos, 31 skills, pipeline SDD+TDD. Plugin de Claude Code; skills y roles para otras herramientas de código.",
  "type": "module",
  "bin": {
    "fragua": "cli/index.js",
    "forge": "cli/index.js",
    "sdd-es": "cli/index.js"
  },
  "scripts": {
    "build": "echo 'No build step required — core/ is pure JS'",
    "typecheck": "tsc",
    "test": "node scripts/pruebas.mjs todo",
    "test:rapido": "node scripts/pruebas.mjs rapido",
    "test:lento": "node scripts/pruebas.mjs lento",
    "test:cuarentena": "node scripts/pruebas.mjs cuarentena",
    "test:verbose": "node scripts/pruebas.mjs todo --reporter=spec",
    "coverage": "node scripts/pruebas.mjs todo --experimental-test-coverage",
    "test:cobertura": "node --test --experimental-test-coverage tests/*.test.js",
    "init": "echo 'Instala con: fragua init  (tras clonar el repositorio: npm install -g .)'",
    "doctor": "node cli/index.js doctor",
    "generar-skills": "node scripts/generar-skills.mjs",
    "prepublishOnly": "node scripts/generar-skills.mjs && npm test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "cli/",
    "bin/",
    "core/",
    "utils/",
    "commands/",
    "agents/",
    "skills/",
    "skills-generadas/",
    "craft/",
    "design-systems/",
    "plantillas/",
    "presets/",
    "claude-hooks/",
    "configuracion-ejemplo/",
    "docs/",
    "!docs/archivo/",
    "!docs/informes/",
    "ui/",
    ".claude-plugin/",
    "scripts/",
    "!scripts/test-bus.mjs",
    ".gitignore",
    ".mcp.json",
    "instalar.sh",
    "instalar.ps1",
    "README.md",
    "AGENTS.md",
    "QUICK-START.md",
    "CHANGELOG.md",
    "VERSIONING.md",
    "LICENSE"
  ],
  "keywords": [
    "forge",
    "claude-code",
    "spec-driven-development",
    "sdd",
    "tdd",
    "español",
    "agentes",
    "mcp",
    "plugin",
    "no-code",
    "citizen-developer"
  ],
  "license": "MIT",
  "homepage": "https://github.com/carlos060798/FORGE",
  "repository": {
    "type": "git",
    "url": "https://github.com/carlos060798/FORGE.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "acorn": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3"
  }
}
