# Dependencias — node_modules no se versiona; package-lock.json sí (la CI instala con `npm ci`)
node_modules/

# Artefactos de compilación TypeScript — generados por `npm run build`
dist/

# Estado local del proyecto (generado en cada repo donde se instala SDD-ES).
# Se versionan solo los artefactos SDD del propio FORGE (ver ADR-10);
# sdd.config.yaml, memoria de agentes, eventos y motor/ siguen ignorados.
.sdd/*
!.sdd/INDICE.md
!.sdd/estado.json
!.sdd/especificaciones/
!.sdd/arquitectura/
!.sdd/dominio/
!.sdd/memoria/
.sdd/memoria/*
!.sdd/memoria/constitucion.md
.sdd/arquitectura/*.jsonl

# Copias de trabajo de las sesiones de agentes: no se versionan
.claude/worktrees/

# Variables de entorno
.env
.env.local

FORGE/

# La skill generada del comando «forge» vive en skills-generadas/forge/: en sistemas que no distinguen
# mayúsculas el patrón anterior la ignoraría y la skill no se versionaría.
!skills-generadas/forge/
!skills-generadas/forge/**

# Registros locales de sesiones: no se versionan
logs/
